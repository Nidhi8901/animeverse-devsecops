@app.route("/")
def home():
    return render_template("index.html", wallpapers=wallpapers)


@app.route("/api/wallpapers")
def api_wallpapers():
    return jsonify(wallpapers)


@app.route("/health")
def health():
    return jsonify({
        "status": "healthy",
        "application": "AnimeVerse"
    })


if __name__ == "__main__":
    app.run(
        host="0.0.0.0",
        port=8000,
        debug=True
    )
